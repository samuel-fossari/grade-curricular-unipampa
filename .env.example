# Copie para `.env` na raiz do projeto e preencha com os valores do Supabase
# (Dashboard → Project Settings → API).
#
# NUNCA commite o arquivo `.env` — ele está no .gitignore.
# NUNCA coloque a service_role key aqui nem no front-end.

# URL do projeto (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública do cliente (Dashboard: "Publishable key", formato sb_publishable_...).
# Equivalente à antiga "anon" / "public" (JWT eyJ...). Usada no browser com RLS.
# Pode ir no cliente; a proteção dos dados vem das políticas RLS, não de esconder esta chave.
SUPABASE_ANON_KEY=

# URL base do site para redirects do Supabase Auth (OAuth Google, confirmação de e-mail).
# Local: mesma porta do npm start (3000). Produção: URL do deploy.
SUPABASE_SITE_URL=http://localhost:3000

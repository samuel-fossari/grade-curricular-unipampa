{
  "name": "grade-curricular-unipampa",
  "version": "1.0.0",
  "description": "Site estático para acompanhar grades curriculares de forma interativa: progresso local, pré-requisitos, ementas, CCCGs, integralização de carga horária e agenda semanal.",
  "main": "sw.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node --test tests/smoke-static.mjs",
    "test:browser": "node tests/smoke-browser.mjs",
    "test:all": "npm test && npm run test:smoke",
    "config": "node scripts/generate-supabase-config.mjs",
    "build": "node scripts/generate-supabase-config.mjs",
    "vercel-build": "node scripts/generate-supabase-config.mjs",
    "start": "npx serve . -l 3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuel-fossari/grade-curricular-unipampa.git"
